config_version=5

[application]
config/name="逃离考场 · 最后一遍铃"
run/main_scene="res://scenes/chapters/chapter_01.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="EscapeExamGodot"

[autoload]
Game="*res://scripts/systems/game.gd"
Ambience="*res://scripts/systems/ambience.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.13, 0.17, 0.19, 1)

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=18.0

[navigation]
3d/default_cell_size=0.15
3d/default_cell_height=0.1

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Teacher"
3d_physics/layer_4="Interaction"
3d_physics/layer_5="Doors"
3d_physics/layer_6="Glass"
3d_physics/layer_7="BakeOnly"

[audio]
buses/default_bus_layout="res://default_bus_layout.tres"
